{
  "name": "agrichain-contracts",
  "version": "1.0.0",
  "description": "AgriChain — Smart contracts for agricultural supply chain traceability",
  "scripts": {
    "compile":     "npx hardhat compile",
    "test":        "npx hardhat test",
    "deploy:local":   "npx hardhat run scripts/deploy.js --network hardhat",
    "deploy:mumbai":  "npx hardhat run scripts/deploy.js --network mumbai",
    "deploy:polygon": "npx hardhat run scripts/deploy.js --network polygon",
    "verify:mumbai":  "npx hardhat verify --network mumbai",
    "node":           "npx hardhat node",
    "clean":          "npx hardhat clean",
    "coverage":       "npx hardhat coverage",
    "gas-report":     "REPORT_GAS=true npx hardhat test"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0",
    "dotenv": "^16.3.1"
  }
}
