# ═══════════════════════════════════════════════════════
# AgriChain — Environment Variables Template
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ──────────────────────────────────────────────────────
# Blockchain / Polygon Mumbai
# ──────────────────────────────────────────────────────
# Get from https://rpc.ankr.com/polygon_mumbai or Alchemy/Infura
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Your MetaMask/Deployer wallet private key (with 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed contract address (set after deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS

# Polygonscan API key for contract verification
# Get from https://polygonscan.com/apis
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_KEY

# ──────────────────────────────────────────────────────
# IPFS / Pinata
# ──────────────────────────────────────────────────────
# Get from https://app.pinata.cloud/keys
NEXT_PUBLIC_PINATA_API_KEY=YOUR_PINATA_API_KEY
NEXT_PUBLIC_PINATA_SECRET_KEY=YOUR_PINATA_SECRET_KEY
PINATA_JWT=YOUR_PINATA_JWT_TOKEN

# ──────────────────────────────────────────────────────
# AI / Backend
# ──────────────────────────────────────────────────────
# Get from https://openweathermap.org/api
OPENWEATHER_API_KEY=YOUR_OPENWEATHERMAP_KEY

# Backend URL (local: http://localhost:5000, production: your Render URL)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# ──────────────────────────────────────────────────────
# Web3Modal / WalletConnect
# ──────────────────────────────────────────────────────
# Get from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# ──────────────────────────────────────────────────────
# Optional: Chainlink (for on-chain oracle integration)
# ──────────────────────────────────────────────────────
# CHAINLINK_SUBSCRIPTION_ID=
# CHAINLINK_VRF_KEY_HASH=
